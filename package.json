{
  "name": "agent-brief-flooently-take-home",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Brief API for agentic.market plus a Flooently Remotion iMessage-style short-video generator.",
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "server": "tsx src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "build": "tsc --noEmit",
    "test": "vitest run",
    "remotion:preview": "remotion studio src/index.ts",
    "remotion:still:french": "remotion still src/index.ts FlooentlyFrenchNaturalText out/flooently-french-natural-text.png --frame=120",
    "render:flooently:french": "remotion render src/index.ts FlooentlyFrenchNaturalText out/flooently-french-natural-text.mp4",
    "render:flooently:spanish": "remotion render src/index.ts FlooentlySpanishReplyPanic out/flooently-spanish-reply-panic.mp4",
    "render:flooently:slang": "remotion render src/index.ts FlooentlyGroupChatSlang out/flooently-group-chat-slang.mp4"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.366",
    "@remotion/renderer": "^4.0.366",
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "@x402/express": "^2.11.0",
    "@x402/extensions": "^2.11.0",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.366"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=18"
  }
}
