# Core storage
PIPELINE_DB_PATH=data/pipeline.sqlite3
RAW_MEDIA_DIR=media/raw
PROCESSED_MEDIA_DIR=media/processed
PUBLISH_QUEUE_DIR=publish_queue
GENERATION_REQUESTS_DIR=generation_requests

# Ingestion
MIN_VIRALITY_SCORE=2.5
REDDIT_USER_AGENT=CompliantContentPipeline/0.1 contact:you@example.com
AUTHORIZED_REDDIT_AUTHORS=

# Optional hooks
OPENMONTAGE_WEBHOOK_URL=
VEO_WEBHOOK_URL=
YTDLP_BINARY=yt-dlp
DIFY_API_URL=
DIFY_API_KEY=
DIFY_USER=viral_pipeline
N8N_WEBHOOK_URL=

# Publishing
REQUIRE_HUMAN_APPROVAL=true
POSTIZ_BINARY=postiz
POSTIZ_INTEGRATION_IDS=

# Automation
AUTOMATION_POLL_SECONDS=15
AUTOMATION_MIN_INTERVAL_MINUTES=15
