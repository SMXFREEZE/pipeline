# Core storage
PIPELINE_DB_PATH=data/pipeline.sqlite3
RAW_MEDIA_DIR=media/raw
PROCESSED_MEDIA_DIR=media/processed
PUBLISH_QUEUE_DIR=publish_queue
GENERATION_REQUESTS_DIR=generation_requests

# Ingestion
MIN_VIRALITY_SCORE=2.5
REDDIT_USER_AGENT=CompliantContentPipeline/0.1 contact:you@example.com
AUTHORIZED_REDDIT_AUTHORS=

# Optional hooks
OPENMONTAGE_WEBHOOK_URL=
VEO_WEBHOOK_URL=
YTDLP_BINARY=yt-dlp
DIFY_API_URL=
DIFY_API_KEY=
DIFY_USER=viral_pipeline
N8N_WEBHOOK_URL=

# Publishing
REQUIRE_HUMAN_APPROVAL=false
POSTIZ_BINARY=postiz
POSTIZ_API_KEY=
POSTIZ_INTEGRATION_IDS=

# Automation
AUTOMATION_POLL_SECONDS=15
AUTOMATION_MIN_INTERVAL_MINUTES=15

# Agent Brief API
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# Optional agentic.market x402/Bazaar mode.
# Leave X402_PAY_TO empty for the free local demo.
X402_PAY_TO=
X402_PRICE=$0.01
X402_NETWORK=eip155:84532
X402_FACILITATOR_URL=https://x402.org/facilitator
# Keep this true for real x402 requests; tests may override it to avoid network calls.
X402_SYNC_FACILITATOR_ON_START=true
